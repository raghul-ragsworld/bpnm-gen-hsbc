<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_D2" targetNamespace="http://example.com/bpmn">
  <bpmn:message id="Message_ApprovalApproved" name="Approval received" />
  <bpmn:message id="Message_ApprovalRejected" name="Rejection received" />
  <bpmn:message id="Message_ApprovalWithdrawn" name="Withdrawal received" />
  <bpmn:process id="Process_D2" name="Diagram 2 - Process and People" isExecutable="false">
    <bpmn:laneSet id="LaneSet_D2">
      <bpmn:lane id="Lane_P1" name="Requester">
        <bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_001</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_004</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Withdrawn</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P2" name="Onboarding Ops">
        <bpmn:flowNodeRef>Task_AOB_002</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_003</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_007</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_019</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_020</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_029</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RemediationAttempts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemediationEscalation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ParkedRemediation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CheckerOutcome</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P3" name="Business Approver">
        <bpmn:flowNodeRef>Task_AOB_005</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_006</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ApprovalApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ApprovalRejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ApprovalWithdrawn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ApprovalTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApprovalEscalation</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_P4" name="Process Ops / Data Platform / Specialist">
        <bpmn:flowNodeRef>Task_AOB_008</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_009</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_010</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_011</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_012</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_013</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_014</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_015</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_016</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_017</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_018</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_021</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_022</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_023</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_024</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_025</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_026</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_027</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AOB_028</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IngestionStatus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_RetryAllowed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ParkedTechnical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SpecialistOutcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PublishSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PublishJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Start" />
    <bpmn:userTask id="Task_AOB_001" name="Submit onboarding request" />
    <bpmn:userTask id="Task_AOB_002" name="Triage and classify">
      <bpmn:documentation>Set routing category, urgency, SLA target, and assigned maker.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Task_AOB_003" name="Completeness gateway">
      <bpmn:documentation>Missing mandatory attributes or evidence routes to clarification; complete requests route to approval.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AOB_004" name="Request clarification (fail path)" />
    <bpmn:userTask id="Task_AOB_005" name="Business approval" />
    <bpmn:eventBasedGateway id="Task_AOB_006" name="Approval event gateway">
      <bpmn:documentation>Wait for approve, reject, withdraw, or a 24-hour timeout.</bpmn:documentation>
    </bpmn:eventBasedGateway>
    <bpmn:manualTask id="Task_AOB_007" name="Create onboarding draft" />
    <bpmn:manualTask id="Task_AOB_008" name="Package for ingestion" />
    <bpmn:manualTask id="Task_AOB_009" name="Ingest to landing" />
    <bpmn:manualTask id="Task_AOB_010" name="Technical error handling">
      <bpmn:documentation>Create a ServiceNow incident, retry no more than twice, then park the case.</bpmn:documentation>
    </bpmn:manualTask>
    <bpmn:parallelGateway id="Task_AOB_011" name="Parallel validations start">
      <bpmn:documentation>Run data quality, reference enrichment, and duplicate detection concurrently.</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:manualTask id="Task_AOB_012" name="Execute DQ ruleset" />
    <bpmn:manualTask id="Task_AOB_013" name="Reference enrichment" />
    <bpmn:manualTask id="Task_AOB_014" name="Duplicate detect &amp; merge decision" />
    <bpmn:parallelGateway id="Task_AOB_015" name="Validation join">
      <bpmn:documentation>Wait for all three validation branches and consolidate their outputs.</bpmn:documentation>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Task_AOB_016" name="Conditional SPECIALIST checks">
      <bpmn:documentation>Require specialist review when the tax review basis is true.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AOB_017" name="Process SPECIALIST review (conditional)" />
    <bpmn:exclusiveGateway id="Task_AOB_018" name="DQ pass gateway">
      <bpmn:documentation>Pass only when DQ, merge, and any required specialist review are acceptable.</bpmn:documentation>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AOB_019" name="Remediation loop">
      <bpmn:documentation>Apply corrections and revalidate, with a maximum of three remediation attempts.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AOB_020" name="Maker-checker (4-eye)">
      <bpmn:documentation>Publish only after independent checker approval; rejection returns to remediation.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_AOB_021" name="Publish to onboarding master" />
    <bpmn:manualTask id="Task_AOB_022" name="Write controls &amp; DQ metrics" />
    <bpmn:manualTask id="Task_AOB_023" name="Distribute to Downstream Systems (transaction)" />
    <bpmn:manualTask id="Task_AOB_024" name="Publish to DDT" />
    <bpmn:manualTask id="Task_AOB_025" name="Publish to Portfolio Analytics Platform" />
    <bpmn:manualTask id="Task_AOB_026" name="Publish to Client Reporting Hub topic" />
    <bpmn:manualTask id="Task_AOB_027" name="Record publication events" />
    <bpmn:manualTask id="Task_AOB_028" name="Update DQ dashboard" />
    <bpmn:userTask id="Task_AOB_029" name="Notify completion" />
    <bpmn:endEvent id="EndEvent_1" name="End" />
    <bpmn:intermediateCatchEvent id="Event_ApprovalApproved" name="Approval received">
      <bpmn:messageEventDefinition messageRef="Message_ApprovalApproved" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ApprovalRejected" name="Rejection received">
      <bpmn:messageEventDefinition messageRef="Message_ApprovalRejected" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ApprovalWithdrawn" name="Withdrawal received">
      <bpmn:messageEventDefinition messageRef="Message_ApprovalWithdrawn" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_ApprovalTimeout" name="24-hour timeout">
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ApprovalEscalation" name="Escalate approval timeout" />
    <bpmn:exclusiveGateway id="Gateway_IngestionStatus" name="Ingestion successful?" />
    <bpmn:exclusiveGateway id="Gateway_RetryAllowed" name="Retry available?" />
    <bpmn:exclusiveGateway id="Gateway_SpecialistOutcome" name="Specialist approved?" />
    <bpmn:exclusiveGateway id="Gateway_RemediationAttempts" name="Remediation attempts available?" />
    <bpmn:serviceTask id="Task_RemediationEscalation" name="Escalate remediation breach" />
    <bpmn:exclusiveGateway id="Gateway_CheckerOutcome" name="Checker approved?" />
    <bpmn:parallelGateway id="Gateway_PublishSplit" name="Publish to consumers" />
    <bpmn:parallelGateway id="Gateway_PublishJoin" name="Consumer publishing complete" />
    <bpmn:endEvent id="End_Withdrawn" name="Request withdrawn" />
    <bpmn:endEvent id="End_ParkedTechnical" name="Parked - Technical" />
    <bpmn:endEvent id="End_ParkedRemediation" name="Parked - Remediation" />
    <bpmn:sequenceFlow id="Flow_001" sourceRef="StartEvent_1" targetRef="Task_AOB_001" />
    <bpmn:sequenceFlow id="Flow_002" sourceRef="Task_AOB_001" targetRef="Task_AOB_002" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="Task_AOB_002" targetRef="Task_AOB_003" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="Task_AOB_003" targetRef="Task_AOB_004" name="Incomplete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Mandatory data or supporting evidence is missing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_005" sourceRef="Task_AOB_003" targetRef="Task_AOB_005" name="Complete">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">All mandatory data and supporting evidence are present</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" sourceRef="Task_AOB_004" targetRef="Task_AOB_001" name="Correct and resubmit" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="Task_AOB_005" targetRef="Task_AOB_006" name="Await outcome" />
    <bpmn:sequenceFlow id="Flow_008" sourceRef="Task_AOB_006" targetRef="Event_ApprovalApproved" name="Approve" />
    <bpmn:sequenceFlow id="Flow_009" sourceRef="Task_AOB_006" targetRef="Event_ApprovalRejected" name="Reject" />
    <bpmn:sequenceFlow id="Flow_010" sourceRef="Task_AOB_006" targetRef="Event_ApprovalWithdrawn" name="Withdraw" />
    <bpmn:sequenceFlow id="Flow_011" sourceRef="Task_AOB_006" targetRef="Event_ApprovalTimeout" name="Timeout" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="Event_ApprovalApproved" targetRef="Task_AOB_007" />
    <bpmn:sequenceFlow id="Flow_013" sourceRef="Event_ApprovalRejected" targetRef="Task_AOB_004" name="Return for correction" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="Event_ApprovalWithdrawn" targetRef="End_Withdrawn" />
    <bpmn:sequenceFlow id="Flow_015" sourceRef="Event_ApprovalTimeout" targetRef="Task_ApprovalEscalation" />
    <bpmn:sequenceFlow id="Flow_016" sourceRef="Task_ApprovalEscalation" targetRef="Task_AOB_006" name="Continue waiting" />
    <bpmn:sequenceFlow id="Flow_017" sourceRef="Task_AOB_007" targetRef="Task_AOB_008" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="Task_AOB_008" targetRef="Task_AOB_009" />
    <bpmn:sequenceFlow id="Flow_019" sourceRef="Task_AOB_009" targetRef="Gateway_IngestionStatus" />
    <bpmn:sequenceFlow id="Flow_020" sourceRef="Gateway_IngestionStatus" targetRef="Task_AOB_011" name="Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Schema validation status is PASS</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_021" sourceRef="Gateway_IngestionStatus" targetRef="Task_AOB_010" name="Failure">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Schema validation status is FAIL</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_022" sourceRef="Task_AOB_010" targetRef="Gateway_RetryAllowed" />
    <bpmn:sequenceFlow id="Flow_023" sourceRef="Gateway_RetryAllowed" targetRef="Task_AOB_009" name="Retry">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Retry count is less than 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_024" sourceRef="Gateway_RetryAllowed" targetRef="End_ParkedTechnical" name="Retries exhausted">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Retry count is at least 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_025" sourceRef="Task_AOB_011" targetRef="Task_AOB_012" name="DQ validation" />
    <bpmn:sequenceFlow id="Flow_026" sourceRef="Task_AOB_011" targetRef="Task_AOB_013" name="Reference enrichment" />
    <bpmn:sequenceFlow id="Flow_027" sourceRef="Task_AOB_011" targetRef="Task_AOB_014" name="Duplicate detection" />
    <bpmn:sequenceFlow id="Flow_028" sourceRef="Task_AOB_012" targetRef="Task_AOB_015" />
    <bpmn:sequenceFlow id="Flow_029" sourceRef="Task_AOB_013" targetRef="Task_AOB_015" />
    <bpmn:sequenceFlow id="Flow_030" sourceRef="Task_AOB_014" targetRef="Task_AOB_015" />
    <bpmn:sequenceFlow id="Flow_031" sourceRef="Task_AOB_015" targetRef="Task_AOB_016" />
    <bpmn:sequenceFlow id="Flow_032" sourceRef="Task_AOB_016" targetRef="Task_AOB_017" name="Review required">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tax review basis is true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_033" sourceRef="Task_AOB_016" targetRef="Task_AOB_018" name="No review required">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tax review basis is false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_034" sourceRef="Task_AOB_017" targetRef="Gateway_SpecialistOutcome" />
    <bpmn:sequenceFlow id="Flow_035" sourceRef="Gateway_SpecialistOutcome" targetRef="Task_AOB_018" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Specialist review outcome is approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_036" sourceRef="Gateway_SpecialistOutcome" targetRef="Task_AOB_019" name="Correction required">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Specialist review requires correction</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_037" sourceRef="Task_AOB_018" targetRef="Task_AOB_020" name="Pass">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">DQ, merge, and specialist outcomes pass</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_038" sourceRef="Task_AOB_018" targetRef="Task_AOB_019" name="Fail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">DQ, merge, or specialist outcome requires remediation</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_039" sourceRef="Task_AOB_019" targetRef="Gateway_RemediationAttempts" />
    <bpmn:sequenceFlow id="Flow_040" sourceRef="Gateway_RemediationAttempts" targetRef="Task_AOB_011" name="Revalidate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Remediation attempt count is at most 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_041" sourceRef="Gateway_RemediationAttempts" targetRef="Task_RemediationEscalation" name="Limit exceeded">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Remediation attempt count exceeds 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_042" sourceRef="Task_RemediationEscalation" targetRef="End_ParkedRemediation" name="Park case" />
    <bpmn:sequenceFlow id="Flow_043" sourceRef="Task_AOB_020" targetRef="Gateway_CheckerOutcome" />
    <bpmn:sequenceFlow id="Flow_044" sourceRef="Gateway_CheckerOutcome" targetRef="Task_AOB_021" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Checker outcome is approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_045" sourceRef="Gateway_CheckerOutcome" targetRef="Task_AOB_019" name="Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Checker outcome is rejected</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_046" sourceRef="Task_AOB_021" targetRef="Task_AOB_022" />
    <bpmn:sequenceFlow id="Flow_047" sourceRef="Task_AOB_022" targetRef="Task_AOB_023" />
    <bpmn:sequenceFlow id="Flow_048" sourceRef="Task_AOB_023" targetRef="Gateway_PublishSplit" />
    <bpmn:sequenceFlow id="Flow_049" sourceRef="Gateway_PublishSplit" targetRef="Task_AOB_024" name="DDT" />
    <bpmn:sequenceFlow id="Flow_050" sourceRef="Gateway_PublishSplit" targetRef="Task_AOB_025" name="Portfolio analytics" />
    <bpmn:sequenceFlow id="Flow_051" sourceRef="Gateway_PublishSplit" targetRef="Task_AOB_026" name="Client reporting" />
    <bpmn:sequenceFlow id="Flow_052" sourceRef="Task_AOB_024" targetRef="Gateway_PublishJoin" />
    <bpmn:sequenceFlow id="Flow_053" sourceRef="Task_AOB_025" targetRef="Gateway_PublishJoin" />
    <bpmn:sequenceFlow id="Flow_054" sourceRef="Task_AOB_026" targetRef="Gateway_PublishJoin" />
    <bpmn:sequenceFlow id="Flow_055" sourceRef="Gateway_PublishJoin" targetRef="Task_AOB_027" />
    <bpmn:sequenceFlow id="Flow_056" sourceRef="Task_AOB_027" targetRef="Task_AOB_028" />
    <bpmn:sequenceFlow id="Flow_057" sourceRef="Task_AOB_028" targetRef="Task_AOB_029" />
    <bpmn:sequenceFlow id="Flow_058" sourceRef="Task_AOB_029" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Process_D2_Diagram">
    <bpmndi:BPMNPlane id="Process_D2_Plane" bpmnElement="Process_D2">
      <bpmndi:BPMNShape id="Lane_P1_di" bpmnElement="Lane_P1" isHorizontal="true" bioc:fill="#F7F9FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="20" y="20" width="8720" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P2_di" bpmnElement="Lane_P2" isHorizontal="true" bioc:fill="#EEF3F8" bioc:stroke="#6C8EBF">
        <dc:Bounds x="20" y="200" width="8720" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P3_di" bpmnElement="Lane_P3" isHorizontal="true" bioc:fill="#F7F9FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="20" y="380" width="8720" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_P4_di" bpmnElement="Lane_P4" isHorizontal="true" bioc:fill="#EEF3F8" bioc:stroke="#6C8EBF">
        <dc:Bounds x="20" y="560" width="8720" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1" bioc:fill="#D5E8D4" bioc:stroke="#2D7600">
        <dc:Bounds x="180" y="92.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_001_di" bpmnElement="Task_AOB_001" bioc:fill="#DAE8FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="360" y="70.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_002_di" bpmnElement="Task_AOB_002" bioc:fill="#DAE8FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="540" y="250.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_003_di" bpmnElement="Task_AOB_003" bioc:fill="#FFE6CC" bioc:stroke="#D79B00">
        <dc:Bounds x="720" y="265.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_004_di" bpmnElement="Task_AOB_004" bioc:fill="#DAE8FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="900" y="70.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_005_di" bpmnElement="Task_AOB_005" bioc:fill="#DAE8FC" bioc:stroke="#6C8EBF">
        <dc:Bounds x="1080" y="430.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_006_di" bpmnElement="Task_AOB_006" bioc:fill="#FFE6CC" bioc:stroke="#D79B00">
        <dc:Bounds x="1260" y="445.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_007_di" bpmnElement="Task_AOB_007" bioc:fill="#FFF2CC" bioc:stroke="#D6B656">
        <dc:Bounds x="1440" y="250.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_008_di" bpmnElement="Task_AOB_008" bioc:fill="#FFF2CC" bioc:stroke="#D6B656">
        <dc:Bounds x="1620" y="610.0" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AOB_009_di" bpmnElement="Task_AOB_009" bioc:fill="#FFF2CC" bioc:stroke="#D6B656">
