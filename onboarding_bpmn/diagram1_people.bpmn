      <bpmn:sequenceFlow id="Flow-010" sourceRef="AOB-006" targetRef="Rejection-Received" name="Reject"/>
      <bpmn:sequenceFlow id="Flow-011" sourceRef="Rejection-Received" targetRef="Rejection-Complete"/>
      <bpmn:sequenceFlow id="Flow-012" sourceRef="AOB-006" targetRef="Withdrawal-Received" name="Withdraw"/>
      <bpmn:sequenceFlow id="Flow-013" sourceRef="Withdrawal-Received" targetRef="Withdrawal-Complete"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="Approval-Timeout" name="24h approval timeout" attachedToRef="Approval-Wait" cancelActivity="true">
      <bpmn:outgoing>Flow-017</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EventDefinition-Approval-Timeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Approval-Outcome" name="Approval outcome" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-014</bpmn:incoming>
      <bpmn:outgoing>Flow-015</bpmn:outgoing>
      <bpmn:outgoing>Flow-016</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Approval-Escalation" name="Ops Lead review / resolve&#10;incident">
      <bpmn:documentation>Explicit timeout resolution step requested by user.</bpmn:documentation>
      <bpmn:incoming>Flow-017</bpmn:incoming>
      <bpmn:outgoing>Flow-018</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="Request-Rejected" name="Request Rejected/Withdrawn">
      <bpmn:incoming>Flow-016</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Draft-Merge" name="Approved or timeout resolved" gatewayDirection="Converging">
      <bpmn:incoming>Flow-015</bpmn:incoming>
      <bpmn:incoming>Flow-018</bpmn:incoming>
      <bpmn:outgoing>Flow-019</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Ingest-Merge" name="Initial ingestion or retry" gatewayDirection="Converging">
      <bpmn:incoming>Flow-021</bpmn:incoming>
      <bpmn:incoming>Flow-027</bpmn:incoming>
      <bpmn:outgoing>Flow-022</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Ingest-Outcome" name="Schema validation outcome" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-023</bpmn:incoming>
      <bpmn:outgoing>Flow-024</bpmn:outgoing>
      <bpmn:outgoing>Flow-025</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Retry-Decision" name="Retry allowance" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-026</bpmn:incoming>
      <bpmn:outgoing>Flow-027</bpmn:outgoing>
      <bpmn:outgoing>Flow-028</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Validation-Merge" name="Initial or corrected draft" gatewayDirection="Converging">
      <bpmn:incoming>Flow-024</bpmn:incoming>
      <bpmn:incoming>Flow-046</bpmn:incoming>
      <bpmn:outgoing>Flow-029</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Specialist-Outcome" name="SPECIALIST outcome" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-039</bpmn:incoming>
      <bpmn:outgoing>Flow-040</bpmn:outgoing>
      <bpmn:outgoing>Flow-041</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Remediation-Merge" name="Remediation required" gatewayDirection="Converging">
      <bpmn:incoming>Flow-041</bpmn:incoming>
      <bpmn:incoming>Flow-042</bpmn:incoming>
      <bpmn:outgoing>Flow-044</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Remediation-Decision" name="Remediation attempt count" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-045</bpmn:incoming>
      <bpmn:outgoing>Flow-046</bpmn:outgoing>
      <bpmn:outgoing>Flow-047</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Breach-Merge" name="Attempt or SLA breach" gatewayDirection="Converging">
      <bpmn:incoming>Flow-047</bpmn:incoming>
      <bpmn:incoming>Flow-048</bpmn:incoming>
      <bpmn:outgoing>Flow-049</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Technical-Parked" name="Parked - Technical">
      <bpmn:incoming>Flow-028</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Remediation-Timer" name="SLA: urgent 4h / standard 24h" attachedToRef="AOB-019" cancelActivity="true">
      <bpmn:outgoing>Flow-048</bpmn:outgoing>
      <bpmn:timerEventDefinition id="EventDefinition-Remediation-Timer">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">if Urgency = 'urgent' then 'PT4H' else 'PT24H'</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:intermediateThrowEvent id="Remediation-Escalation" name="Escalate remediation breach">
      <bpmn:incoming>Flow-049</bpmn:incoming>
      <bpmn:outgoing>Flow-050</bpmn:outgoing>
      <bpmn:escalationEventDefinition id="EventDefinition-Remediation-Escalation" escalationRef="Escalation-Remediation"/>
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Remediation-Parked" name="Parked - Remediation Exhausted">
      <bpmn:incoming>Flow-050</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:parallelGateway id="Delivery-Split" name="Parallel downstream delivery" gatewayDirection="Diverging">
      <bpmn:incoming>Flow-054</bpmn:incoming>
      <bpmn:outgoing>Flow-055</bpmn:outgoing>
      <bpmn:outgoing>Flow-057</bpmn:outgoing>
      <bpmn:outgoing>Flow-059</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:parallelGateway id="Delivery-Join" name="Delivery outcomes recorded" gatewayDirection="Converging">
      <bpmn:incoming>Flow-056</bpmn:incoming>
      <bpmn:incoming>Flow-058</bpmn:incoming>
      <bpmn:incoming>Flow-060</bpmn:incoming>
      <bpmn:outgoing>Flow-061</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sequenceFlow id="Flow-001" sourceRef="AOB-001" targetRef="AOB-002"/>
    <bpmn:sequenceFlow id="Flow-002" sourceRef="AOB-002" targetRef="AOB-003"/>
    <bpmn:sequenceFlow id="Flow-003" sourceRef="AOB-003" targetRef="AOB-004" name="FAIL: mandatory&#10;attribute/evidence missing">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">mandatory attribute/evidence missing</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-004" sourceRef="AOB-004" targetRef="AOB-003" name="Clarification supplied: recheck&#10;completeness"/>
    <bpmn:sequenceFlow id="Flow-005" sourceRef="AOB-003" targetRef="AOB-005" name="PASS: else (no mandatory&#10;attribute/evidence missing)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (mandatory attribute/evidence missing)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-006" sourceRef="AOB-005" targetRef="Approval-Wait"/>
    <bpmn:sequenceFlow id="Flow-014" sourceRef="Approval-Wait" targetRef="Approval-Outcome"/>
    <bpmn:sequenceFlow id="Flow-015" sourceRef="Approval-Outcome" targetRef="Draft-Merge" name="Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Approval Outcome = Approve</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-016" sourceRef="Approval-Outcome" targetRef="Request-Rejected" name="Reject/Withdraw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Approval Outcome = Reject OR Approval Outcome = Withdraw</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-017" sourceRef="Approval-Timeout" targetRef="Approval-Escalation" name="Timeout (24h): ServiceNow&#10;incident + escalation to Ops&#10;Lead"/>
    <bpmn:sequenceFlow id="Flow-018" sourceRef="Approval-Escalation" targetRef="Draft-Merge" name="Ops Lead review resolved"/>
    <bpmn:sequenceFlow id="Flow-019" sourceRef="Draft-Merge" targetRef="AOB-007" name="Continue with approved/resolved&#10;request"/>
    <bpmn:sequenceFlow id="Flow-020" sourceRef="AOB-007" targetRef="AOB-008"/>
    <bpmn:sequenceFlow id="Flow-021" sourceRef="AOB-008" targetRef="Ingest-Merge"/>
    <bpmn:sequenceFlow id="Flow-022" sourceRef="Ingest-Merge" targetRef="AOB-009" name="Ingest package"/>
    <bpmn:sequenceFlow id="Flow-023" sourceRef="AOB-009" targetRef="Ingest-Outcome"/>
    <bpmn:sequenceFlow id="Flow-024" sourceRef="Ingest-Outcome" targetRef="Validation-Merge" name="Schema Validation Status = PASS">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Schema Validation Status = PASS</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-025" sourceRef="Ingest-Outcome" targetRef="AOB-010" name="Schema Validation Status = FAIL">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Schema Validation Status = FAIL</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-026" sourceRef="AOB-010" targetRef="Retry-Decision"/>
    <bpmn:sequenceFlow id="Flow-027" sourceRef="Retry-Decision" targetRef="Ingest-Merge" name="Retry &lt;=2 (next retry number&#10;&lt;=2)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">next retry number &lt;= 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-028" sourceRef="Retry-Decision" targetRef="Technical-Parked" name="Else: retries exhausted (next&#10;retry number &gt;2)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">next retry number &gt; 2</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-029" sourceRef="Validation-Merge" targetRef="AOB-011" name="Validate initial/corrected draft"/>
    <bpmn:sequenceFlow id="Flow-030" sourceRef="AOB-011" targetRef="AOB-012" name="Spawn in parallel: DQ ruleset"/>
    <bpmn:sequenceFlow id="Flow-031" sourceRef="AOB-012" targetRef="AOB-015"/>
    <bpmn:sequenceFlow id="Flow-032" sourceRef="AOB-011" targetRef="AOB-013" name="Spawn in parallel: Reference&#10;enrichment"/>
    <bpmn:sequenceFlow id="Flow-033" sourceRef="AOB-013" targetRef="AOB-015"/>
    <bpmn:sequenceFlow id="Flow-034" sourceRef="AOB-011" targetRef="AOB-014" name="Spawn in parallel: Duplicate&#10;detection"/>
    <bpmn:sequenceFlow id="Flow-035" sourceRef="AOB-014" targetRef="AOB-015"/>
    <bpmn:sequenceFlow id="Flow-036" sourceRef="AOB-015" targetRef="AOB-016" name="All three validation branches&#10;complete"/>
    <bpmn:sequenceFlow id="Flow-037" sourceRef="AOB-016" targetRef="AOB-017" name="Tax Review Basis=TRUE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tax Review Basis = TRUE</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-038" sourceRef="AOB-016" targetRef="AOB-018" name="Else: Tax Review Basis=FALSE">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Tax Review Basis = FALSE</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-039" sourceRef="AOB-017" targetRef="Specialist-Outcome"/>
    <bpmn:sequenceFlow id="Flow-040" sourceRef="Specialist-Outcome" targetRef="AOB-018" name="Approved">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Specialist Review Outcome = Approved</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-041" sourceRef="Specialist-Outcome" targetRef="Remediation-Merge" name="Correction Required">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Specialist Review Outcome = Correction Required</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-042" sourceRef="AOB-018" targetRef="Remediation-Merge" name="FAIL: DQ/Merge/Specialist&#10;require remediation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">DQ fail OR Merge remediation OR Specialist correction</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-043" sourceRef="AOB-018" targetRef="AOB-020" name="PASS: else (DQ/Merge/Specialist&#10;do not require remediation)">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">not (DQ fail OR Merge remediation OR Specialist correction)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-044" sourceRef="Remediation-Merge" targetRef="AOB-019" name="Correct failed fields"/>
    <bpmn:sequenceFlow id="Flow-045" sourceRef="AOB-019" targetRef="Remediation-Decision"/>
    <bpmn:sequenceFlow id="Flow-046" sourceRef="Remediation-Decision" targetRef="Validation-Merge" name="Attempt &lt;3: loop to AOB-011">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Remediation Attempt Count &lt; 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-047" sourceRef="Remediation-Decision" targetRef="Breach-Merge" name="Attempt =3: max 3 attempts&#10;reached">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Remediation Attempt Count = 3</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow-048" sourceRef="Remediation-Timer" targetRef="Breach-Merge" name="SLA breach: urgent 4h / standard&#10;24h"/>
    <bpmn:sequenceFlow id="Flow-049" sourceRef="Breach-Merge" targetRef="Remediation-Escalation" name="Escalate breach"/>
    <bpmn:sequenceFlow id="Flow-050" sourceRef="Remediation-Escalation" targetRef="Remediation-Parked"/>
    <bpmn:sequenceFlow id="Flow-051" sourceRef="AOB-020" targetRef="AOB-021" name="Checker approval required"/>
    <bpmn:sequenceFlow id="Flow-052" sourceRef="AOB-021" targetRef="AOB-022"/>
    <bpmn:sequenceFlow id="Flow-053" sourceRef="AOB-022" targetRef="AOB-023"/>
    <bpmn:sequenceFlow id="Flow-054" sourceRef="AOB-023" targetRef="Delivery-Split"/>
    <bpmn:sequenceFlow id="Flow-055" sourceRef="Delivery-Split" targetRef="AOB-024" name="Parallel delivery: Publish to&#10;DDT"/>
    <bpmn:sequenceFlow id="Flow-056" sourceRef="AOB-024" targetRef="Delivery-Join" name="Update Consumer Delivery Status&#10;independently"/>
    <bpmn:sequenceFlow id="Flow-057" sourceRef="Delivery-Split" targetRef="AOB-025" name="Parallel delivery: Publish to&#10;Portfolio Analytics Platform"/>
    <bpmn:sequenceFlow id="Flow-058" sourceRef="AOB-025" targetRef="Delivery-Join" name="Update Consumer Delivery Status&#10;independently"/>
    <bpmn:sequenceFlow id="Flow-059" sourceRef="Delivery-Split" targetRef="AOB-026" name="Parallel delivery: Publish to&#10;Client Reporting Hub topic"/>
    <bpmn:sequenceFlow id="Flow-060" sourceRef="AOB-026" targetRef="Delivery-Join" name="Update Consumer Delivery Status&#10;independently"/>
    <bpmn:sequenceFlow id="Flow-061" sourceRef="Delivery-Join" targetRef="AOB-027" name="All delivery outcomes available"/>
    <bpmn:sequenceFlow id="Flow-062" sourceRef="AOB-027" targetRef="AOB-028"/>
    <bpmn:sequenceFlow id="Flow-063" sourceRef="AOB-028" targetRef="AOB-029"/>
    <bpmn:dataObject id="DataObject-AOB-002"/>
