    <bpmn:dataObject id="DataObject-AOB-012"/>
    <bpmn:dataObjectReference id="BDE-AOB-012" dataObjectRef="DataObject-AOB-012" name="AOB-012: 6 BDE mappings&#10;Source / target / transformations">
      <bpmn:documentation>[
  {
    "PSDATA ID": "PSDATA-AOB-012-01",
    "Process Step ID": "AOB-012",
    "Process Step": "Execute DQ ruleset",
    "Src/Tgt": "Target",
    "BDE Name": "DQ Rule Failures",
    "Data Transformation Logic": "Persist failed rule IDs, field-level failures, severities"
  },
  {
    "PSDATA ID": "PSDATA-AOB-012-02",
    "Process Step ID": "AOB-012",
    "Process Step": "Execute DQ ruleset",
    "Src/Tgt": "Target",
    "BDE Name": "Process Open Date",
    "Data Transformation Logic": "Must be ≤ today; must be ≤ Process Closed Date if present"
  },
  {
    "PSDATA ID": "PSDATA-AOB-012-03",
    "Process Step ID": "AOB-012",
