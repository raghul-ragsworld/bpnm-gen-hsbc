<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WF-01_definitions" targetNamespace="urn:onboarding:CR-2026-09-17.2:WF-01">
  <bpmn:process id="WF-01_process" name="Retail Account Onboarding" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Expand identity, duplicate resolution, screening, product, and access\r\ncontrols into 24 activities. Evidence failure returns to step 6 and repeats\r\nstep 7 and step 8. An ambiguous match enters step 11 before step 12; otherwise\r\nbypass step 11. A screening hit enters step 13 for clearance, hold, or decline;\r\nclear cases proceed to step 14. Product ineligibility returns to step 16 for\r\nan eligible selection or closes as declined. Approval corrections return to\r\nthe affected capture/check and repeat step 19. Provisioning retries only the\r\nfailed step 20, step 21, or step 22, then repeat readiness at step 23.","source_rows":[{"id":"AOB-PR-1001-V01-S001","name":"Submit onboarding request - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S002","name":"Triage and classify - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S003","name":"Completeness gateway - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S004","name":"Request clarification (fail path) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S005","name":"Business approval - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S006","name":"Approval event gateway - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S007","name":"Create onboarding draft - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S008","name":"Package for ingestion - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S009","name":"Ingest to landing - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S010","name":"Technical error handling - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S011","name":"Parallel validations start - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S012","name":"Execute DQ ruleset - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S013","name":"Reference enrichment - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S014","name":"Duplicate detect &amp; merge decision - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S015","name":"Validation join - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S016","name":"Conditional SPECIALIST checks - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S017","name":"Process SPECIALIST review (conditional) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S018","name":"DQ pass gateway - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S019","name":"Remediation loop - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S020","name":"Maker-checker (4-eye) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S021","name":"Publish to onboarding master - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S022","name":"Write controls &amp; DQ metrics - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S023","name":"Distribute to Downstream Systems (transaction) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S024","name":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S025","name":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S026","name":"Publish to Client Reporting Hub topic - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S027","name":"Record publication events - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S028","name":"Update DQ dashboard - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V01-S029","name":"Notify completion - Retail Account Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"}],"source_evidence":{"process":{"Process ID":"AOB-PR-1001-V01","L4 Process Name":"Retail Account Onboarding","Process Description":"Intake, verification and setup for new-to-bank retail customers","Process Repository Reference ID":"BUSINESS-CL-ONB-1001","Value Stream":"Customer Lifecycle","L2 Business Function":"Client Onboarding","Capability":"Master Data Utility","Data Sub-domain":"Customer Setup","Data Domain":"Customer Lifecycle - Client Onboarding","Business Data Domain Owner":"Ansuman","Business Data Domain Owner Delegate":"Rahul"},"steps":[{"Process Step ID":"AOB-PR-1001-V01-S001","Process ID":"AOB-PR-1001-V01","Reorder":10,"Process Step":"Submit onboarding request - Retail Account Onboarding","Process Step Description":"Requestor submits onboarding requests with mandatory attributes and evidence references; Tracking ID created.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Request Payload","Target BDEs":"Ticket Record","Data Transformed":"Minimal (format validation)","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S002","Process ID":"AOB-PR-1001-V01","Reorder":20,"Process Step":"Triage and classify - Retail Account Onboarding","Process Step Description":"Ops reviews request, classifies route (FD/SA), urgency, sets SLA and assigns maker.","Data Involved":"Ticket metadata","Source BDEs":"Ticket Record","Target BDEs":"Routed Ticket","Data Transformed":"Routing tags applied","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S003","Process ID":"AOB-PR-1001-V01","Reorder":30,"Process Step":"Completeness gateway - Retail Account Onboarding","Process Step Description":"Mandatory fields/evidence check; fail → AOB-PR-1001-V01-S004, pass → AOB-PR-1001-V01-S005.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Routed Ticket","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S004","Process ID":"AOB-PR-1001-V01","Reorder":40,"Process Step":"Request clarification (fail path) - Retail Account Onboarding","Process Step Description":"Return to requestor with reason codes; loop to AOB-PR-1001-V01-S003.","Data Involved":"Missing field list","Source BDEs":"Routed Ticket","Target BDEs":"Updated Ticket","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S005","Process ID":"AOB-PR-1001-V01","Reorder":50,"Process Step":"Business approval - Retail Account Onboarding","Process Step Description":"Business approver confirms request is valid and authorised.","Data Involved":"Key Process attributes","Source BDEs":"Routed Ticket","Target BDEs":"Approved/Rejected","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S006","Process ID":"AOB-PR-1001-V01","Reorder":60,"Process Step":"Approval event gateway - Retail Account Onboarding","Process Step Description":"Wait for approve/reject/withdraw/timeout; timeout → escalation.","Data Involved":"Approval status","Source BDEs":"Approval Task","Target BDEs":"Outcome event","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S007","Process ID":"AOB-PR-1001-V01","Reorder":70,"Process Step":"Create onboarding draft - Retail Account Onboarding","Process Step Description":"Maker maps request to draft, creates v1 + change log.","Data Involved":"Process attributes","Source BDEs":"Approved Ticket","Target BDEs":"Draft Record v1","Data Transformed":"Standardisation + typing","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S008","Process ID":"AOB-PR-1001-V01","Reorder":80,"Process Step":"Package for ingestion - Retail Account Onboarding","Process Step Description":"Create ingestion package, apply naming/checksum/encryption.","Data Involved":"Draft Record","Source BDEs":"Draft Record v1","Target BDEs":"Ingestion Package","Data Transformed":"Canonical field mapping","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S009","Process ID":"AOB-PR-1001-V01","Reorder":90,"Process Step":"Ingest to landing - Retail Account Onboarding","Process Step Description":"Platform ingests package; schema validation.","Data Involved":"Draft + metadata","Source BDEs":"Ingestion Package","Target BDEs":"Landing Record","Data Transformed":"Schema/format coercion","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S010","Process ID":"AOB-PR-1001-V01","Reorder":100,"Process Step":"Technical error handling - Retail Account Onboarding","Process Step Description":"Incident created; retry/park decision (max 2 retries).","Data Involved":"Error details","Source BDEs":"Ingest logs","Target BDEs":"Incident/Retry/Parked","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S011","Process ID":"AOB-PR-1001-V01","Reorder":110,"Process Step":"Parallel validations start - Retail Account Onboarding","Process Step Description":"Run DQ, enrichment, duplicate detection in parallel; join at AOB-PR-1001-V01-S015.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Validation outputs","Data Transformed":"Varies","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S012","Process ID":"AOB-PR-1001-V01","Reorder":120,"Process Step":"Execute DQ ruleset - Retail Account Onboarding","Process Step Description":"Automated DQ checks: completeness, code sets, date logic, uniqueness.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"DQ Results","Data Transformed":"Flags/scores calculated","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S013","Process ID":"AOB-PR-1001-V01","Reorder":130,"Process Step":"Reference enrichment - Retail Account Onboarding","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S014","Process ID":"AOB-PR-1001-V01","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Retail Account Onboarding","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S015","Process ID":"AOB-PR-1001-V01","Reorder":150,"Process Step":"Validation join - Retail Account Onboarding","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S016","Process ID":"AOB-PR-1001-V01","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Retail Account Onboarding","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S017","Process ID":"AOB-PR-1001-V01","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Retail Account Onboarding","Process Step Description":"SPECIALIST reviews tax-triggered cases.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Tax Approved / Correction Required","Data Transformed":"Possible corrections","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S018","Process ID":"AOB-PR-1001-V01","Reorder":180,"Process Step":"DQ pass gateway - Retail Account Onboarding","Process Step Description":"Evaluate DQ + Merge + Specialist outcomes; fail → AOB-PR-1001-V01-S019, pass → AOB-PR-1001-V01-S020.","Data Involved":"DQ + merge + specialist outcomes","Source BDEs":"Validated Draft","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S019","Process ID":"AOB-PR-1001-V01","Reorder":190,"Process Step":"Remediation loop - Retail Account Onboarding","Process Step Description":"Maker corrects and resubmits; max 3 attempts; loop to AOB-PR-1001-V01-S011.","Data Involved":"Failed fields","Source BDEs":"Fail reasons + draft","Target BDEs":"Corrected Draft / Parked","Data Transformed":"Data corrections","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S020","Process ID":"AOB-PR-1001-V01","Reorder":200,"Process Step":"Maker-checker (4-eye) - Retail Account Onboarding","Process Step Description":"Checker reviews, approves/rejects with reasons; logged for audit.","Data Involved":"Approved candidate","Source BDEs":"Validated/Corrected Draft","Target BDEs":"Checker Outcome","Data Transformed":"Controlled edits + audit","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S021","Process ID":"AOB-PR-1001-V01","Reorder":210,"Process Step":"Publish to onboarding master - Retail Account Onboarding","Process Step Description":"Publish to Azure Data Lake master; stamp lineage/audit.","Data Involved":"Approved record","Source BDEs":"Checker Approved Draft","Target BDEs":"Onboarding Master Record","Data Transformed":"Audit stamping","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S022","Process ID":"AOB-PR-1001-V01","Reorder":220,"Process Step":"Write controls &amp; DQ metrics - Retail Account Onboarding","Process Step Description":"Persist DQ results, approvals, remediation history to controls dataset.","Data Involved":"Control metrics","Source BDEs":"DQ/Workflow outputs","Target BDEs":"Controls &amp; DQ Record","Data Transformed":"Aggregation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S023","Process ID":"AOB-PR-1001-V01","Reorder":230,"Process Step":"Distribute to Downstream Systems (transaction) - Retail Account Onboarding","Process Step Description":"Parallel fan-out; record per-consumer status; allow replay.","Data Involved":"Published record","Source BDEs":"Onboarding Master Record","Target BDEs":"Consumer payloads + statuses","Data Transformed":"Consumer mapping","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S024","Process ID":"AOB-PR-1001-V01","Reorder":240,"Process Step":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Retail Account Onboarding","Process Step Description":"Produce DDT-specific extract and deliver.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"DDT delivery","Data Transformed":"Schema mapping","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S025","Process ID":"AOB-PR-1001-V01","Reorder":250,"Process Step":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Retail Account Onboarding","Process Step Description":"Deliver via API MANAGEMENT + AZURE FUNCTIONS (OR API INTEGRATION LAYER (AZURE API MANAGEMENT)) to Analytics Consumer B with retries and idempotency using Tracking ID.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"Analytics delivery","Data Transformed":"Schema mapping","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S026","Process ID":"AOB-PR-1001-V01","Reorder":260,"Process Step":"Publish to Client Reporting Hub topic - Retail Account Onboarding","Process Step Description":"Publish event/message to Reporting Consumer C (Hackathon) or Downstream Reporting Hub (Consumer C) via Azure Service Bus Topic.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"CRH message","Data Transformed":"Event translation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S027","Process ID":"AOB-PR-1001-V01","Reorder":270,"Process Step":"Record publication events - Retail Account Onboarding","Process Step Description":"Append delivery events for audit/replay/monitoring.","Data Involved":"Event data","Source BDEs":"Delivery outcomes","Target BDEs":"Publication Events","Data Transformed":"Event normalisation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S028","Process ID":"AOB-PR-1001-V01","Reorder":280,"Process Step":"Update DQ dashboard - Retail Account Onboarding","Process Step Description":"Refresh dashboard with status + DQ metrics.","Data Involved":"Metrics","Source BDEs":"Controls &amp; DQ Record","Target BDEs":"Dashboard view","Data Transformed":"Aggregation","L4 Process Name":"Retail Account Onboarding"},{"Process Step ID":"AOB-PR-1001-V01-S029","Process ID":"AOB-PR-1001-V01","Reorder":290,"Process Step":"Notify completion - Retail Account Onboarding","Process Step Description":"Notify requestor/stakeholders with outcome + Tracking ID.","Data Involved":"Status","Source BDEs":"Publication Events","Target BDEs":"Notifications","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding"}],"details":[{"PSD ID":"PSD-AOB-PR-1001-V01-S001-01","Process Step ID":"AOB-PR-1001-V01-S001","Process Step":"Submit onboarding request - Retail Account Onboarding","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V01-S001-02","Process Step ID":"AOB-PR-1001-V01-S001","Process Step":"Submit onboarding request - Retail Account Onboarding","Detail Type":"Input","Detail Value":"Process attributes + Supporting Evidence References","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V01-S001-03","Process Step ID":"AOB-PR-1001-V01-S001","Process Step":"Submit onboarding request - Retail Account Onboarding","Detail Type":"Tracking","Detail Value":"Create Tracking ID (Correlation ID) at intake; persist end-to-end","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V01-S001-04","Process Step ID":"AOB-PR-1001-V01-S001","Process Step":"Submit onboarding request - Retail Account Onboarding","Detail Type":"Output","Detail Value":"Ticket contains submitted Process attributes, Supporting Evidence References, and Tracking ID","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V01-S002-01","Process Step ID":"AOB-PR-1001-V01-S002","Process Step":"Triage and classify - Retail Account Onboarding","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S002-02","Process Step ID":"AOB-PR-1001-V01-S002","Process Step":"Triage and classify - Retail Account Onboarding","Detail Type":"Output","Detail Value":"Set Routing Category, Urgency, SLA Target; assign maker","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S003-01","Process Step ID":"AOB-PR-1001-V01-S003","Process Step":"Completeness gateway - Retail Account Onboarding","Detail Type":"Gateway Rule (XOR)","Detail Value":"If any mandatory attribute missing OR evidence missing -&gt; AOB-PR-1001-V01-S004; else -&gt; AOB-PR-1001-V01-S005","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=Ops Lead, C=Onboarding Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S003-02","Process Step ID":"AOB-PR-1001-V01-S003","Process Step":"Completeness gateway - Retail Account Onboarding","Detail Type":"Mandatory Fields (Hackathon Standard)","Detail Value":"Process Code, Process Country, Process Currency, Process Name, Process Open Date, Process Status, Responsible Groups","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=Ops Lead, C=Onboarding Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S003-03","Process Step ID":"AOB-PR-1001-V01-S003","Process Step":"Completeness gateway - Retail Account Onboarding","Detail Type":"Evidence Rule","Detail Value":"Minimum 1 Supporting Evidence References entry required","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=Ops Lead, C=Onboarding Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S004-01","Process Step ID":"AOB-PR-1001-V01-S004","Process Step":"Request clarification (fail path) - Retail Account Onboarding","Detail Type":"Output","Detail Value":"Return Missing-field Reason Codes (e.g., MISS_CCY, MISS_EVID) and resubmission instructions","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1001-V01-S005-01","Process Step ID":"AOB-PR-1001-V01-S005","Process Step":"Business approval - Retail Account Onboarding","Detail Type":"Control","Detail Value":"Delegated authority approval required before ingestion","Process Step Owner":"Approver","RACI":"R=Approver, A=Approver