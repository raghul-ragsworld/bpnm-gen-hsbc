Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S007","Process ID":"AOB-PR-1001-V02","Reorder":70,"Process Step":"Create onboarding draft - Retail Account Onboarding - Variant A","Process Step Description":"Maker maps request to draft, creates v1 + change log.","Data Involved":"Process attributes","Source BDEs":"Approved Ticket","Target BDEs":"Draft Record v1","Data Transformed":"Standardisation + typing","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S008","Process ID":"AOB-PR-1001-V02","Reorder":80,"Process Step":"Package for ingestion - Retail Account Onboarding - Variant A","Process Step Description":"Create ingestion package, apply naming/checksum/encryption.","Data Involved":"Draft Record","Source BDEs":"Draft Record v1","Target BDEs":"Ingestion Package","Data Transformed":"Canonical field mapping","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S009","Process ID":"AOB-PR-1001-V02","Reorder":90,"Process Step":"Ingest to landing - Retail Account Onboarding - Variant A","Process Step Description":"Platform ingests package; schema validation.","Data Involved":"Draft + metadata","Source BDEs":"Ingestion Package","Target BDEs":"Landing Record","Data Transformed":"Schema/format coercion","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S010","Process ID":"AOB-PR-1001-V02","Reorder":100,"Process Step":"Technical error handling - Retail Account Onboarding - Variant A","Process Step Description":"Incident created; retry/park decision (max 2 retries).","Data Involved":"Error details","Source BDEs":"Ingest logs","Target BDEs":"Incident/Retry/Parked","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S011","Process ID":"AOB-PR-1001-V02","Reorder":110,"Process Step":"Parallel validations start - Retail Account Onboarding - Variant A","Process Step Description":"Run DQ, enrichment, duplicate detection in parallel; join at AOB-PR-1001-V02-S015.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Validation outputs","Data Transformed":"Varies","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S012","Process ID":"AOB-PR-1001-V02","Reorder":120,"Process Step":"Execute DQ ruleset - Retail Account Onboarding - Variant A","Process Step Description":"Automated DQ checks: completeness, code sets, date logic, uniqueness.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"DQ Results","Data Transformed":"Flags/scores calculated","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S013","Process ID":"AOB-PR-1001-V02","Reorder":130,"Process Step":"Reference enrichment - Retail Account Onboarding - Variant A","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S014","Process ID":"AOB-PR-1001-V02","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Retail Account Onboarding - Variant A","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S015","Process ID":"AOB-PR-1001-V02","Reorder":150,"Process Step":"Validation join - Retail Account Onboarding - Variant A","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S016","Process ID":"AOB-PR-1001-V02","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Retail Account Onboarding - Variant A","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S017","Process ID":"AOB-PR-1001-V02","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Retail Account Onboarding - Variant A","Process Step Description":"SPECIALIST reviews tax-triggered cases.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Tax Approved / Correction Required","Data Transformed":"Possible corrections","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S018","Process ID":"AOB-PR-1001-V02","Reorder":180,"Process Step":"DQ pass gateway - Retail Account Onboarding - Variant A","Process Step Description":"Evaluate DQ + Merge + Specialist outcomes; fail → AOB-PR-1001-V02-S019, pass → AOB-PR-1001-V02-S020.","Data Involved":"DQ + merge + specialist outcomes","Source BDEs":"Validated Draft","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S019","Process ID":"AOB-PR-1001-V02","Reorder":190,"Process Step":"Remediation loop - Retail Account Onboarding - Variant A","Process Step Description":"Maker corrects and resubmits; max 3 attempts; loop to AOB-PR-1001-V02-S011.","Data Involved":"Failed fields","Source BDEs":"Fail reasons + draft","Target BDEs":"Corrected Draft / Parked","Data Transformed":"Data corrections","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S020","Process ID":"AOB-PR-1001-V02","Reorder":200,"Process Step":"Maker-checker (4-eye) - Retail Account Onboarding - Variant A","Process Step Description":"Checker reviews, approves/rejects with reasons; logged for audit.","Data Involved":"Approved candidate","Source BDEs":"Validated/Corrected Draft","Target BDEs":"Checker Outcome","Data Transformed":"Controlled edits + audit","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S021","Process ID":"AOB-PR-1001-V02","Reorder":210,"Process Step":"Publish to onboarding master - Retail Account Onboarding - Variant A","Process Step Description":"Publish to Azure Data Lake master; stamp lineage/audit.","Data Involved":"Approved record","Source BDEs":"Checker Approved Draft","Target BDEs":"Onboarding Master Record","Data Transformed":"Audit stamping","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S022","Process ID":"AOB-PR-1001-V02","Reorder":220,"Process Step":"Write controls &amp; DQ metrics - Retail Account Onboarding - Variant A","Process Step Description":"Persist DQ results, approvals, remediation history to controls dataset.","Data Involved":"Control metrics","Source BDEs":"DQ/Workflow outputs","Target BDEs":"Controls &amp; DQ Record","Data Transformed":"Aggregation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S023","Process ID":"AOB-PR-1001-V02","Reorder":230,"Process Step":"Distribute to Downstream Systems (transaction) - Retail Account Onboarding - Variant A","Process Step Description":"Parallel fan-out; record per-consumer status; allow replay.","Data Involved":"Published record","Source BDEs":"Onboarding Master Record","Target BDEs":"Consumer payloads + statuses","Data Transformed":"Consumer mapping","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"