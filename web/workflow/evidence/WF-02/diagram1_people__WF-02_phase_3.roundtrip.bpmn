omes","Target BDEs":"Publication Events","Data Transformed":"Event normalisation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S028","Process ID":"AOB-PR-1001-V02","Reorder":280,"Process Step":"Update DQ dashboard - Retail Account Onboarding - Variant A","Process Step Description":"Refresh dashboard with status + DQ metrics.","Data Involved":"Metrics","Source BDEs":"Controls &amp; DQ Record","Target BDEs":"Dashboard view","Data Transformed":"Aggregation","L4 Process Name":"Retail Account Onboarding - Variant A"},{"Process Step ID":"AOB-PR-1001-V02-S029","Process ID":"AOB-PR-1001-V02","Reorder":290,"Process Step":"Notify completion - Retail Account Onboarding - Variant A","Process Step Description":"Notify requestor/stakeholders with outcome + Tracking ID.","Data Involved":"Status","Source BDEs":"Publication Events","Target BDEs":"Notifications","Data Transformed":"None","L4 Process Name":"Retail Account Onboarding - Variant A"}],"details":[{"PSD ID":"PSD-AOB-PR-1001-V02-S001-01","Process Step ID":"AOB-PR-1001-V02-S001","Process Step":"Submit onboarding request - Retail Account Onboarding - Variant A","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V02-S001-02","Process Step ID":"AOB-PR-1001-V02-S001","Process Step":"Submit onboarding request - Retail Account Onboarding - Variant A","Detail Type":"Input","Detail Value":"Process attributes + Supporting Evidence References","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1001-V02-S001-03","Process Step ID":"AOB-PR-1001-V02-S001","Process Step":"Submit onboarding request - Retail Account Onboarding - Variant A","Detail Type":"Tracking","Detail Value":"Create Tracking ID (Correlation ID) at intake; persist end-to-end","Process Step Owner