<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WF-02_definitions" targetNamespace="urn:onboarding:CR-2026-09-17.2:WF-02">
  <bpmn:process id="WF-02_process" name="Retail Account Onboarding - Variant A" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Add original-document inspection, staff attestation, signature, and\r\nhandover controls rather than copying the digital route. Discrepancies at\r\nstep 10 enter step 11 then repeat step 6 through step 10; clear cases bypass\r\nstep 11. Unreadable copies repeat step 8. Screening hits stop at step 16 until\r\nclearance or decline. Checker findings return to the affected evidence step\r\nand repeat step 23 and step 24. Failed handover returns to step 27 after\r\nidentity correction without recreating the account. The branch interpretation\r\nof Variant A remains a proposed design assumption.","source_rows":[{"id":"AOB-PR-1001-V02-S001","name":"Submit onboarding request - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S002","name":"Triage and classify - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S003","name":"Completeness gateway - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S004","name":"Request clarification (fail path) - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S005","name":"Business approval - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S006","name":"Approval event gateway - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S007","name":"Create onboarding draft - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S008","name":"Package for ingestion - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S009","name":"Ingest to landing - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S010","name":"Technical error handling - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S011","name":"Parallel validations start - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S012","name":"Execute DQ ruleset - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S013","name":"Reference enrichment - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S014","name":"Duplicate detect &amp; merge decision - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S015","name":"Validation join - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S016","name":"Conditional SPECIALIST checks - Retail Account Onboarding - Variant A","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1001-V02-S017","name":"Process SPECIALIST review (con