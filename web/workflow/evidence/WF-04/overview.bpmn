  <bpmn:process id="WF-04_process" name="SME Account Opening - Express" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Keep this route shorter because validated evidence is reused. Failure\r\nat step 4 transfers to WF-03 step 3; stale evidence at step 6 transfers to\r\nWF-03 step 6; changed ownership at step 7 transfers to WF-03 step 9. Screening\r\nhits transfer to WF-03 step 18 with both screening results. Transfers retain\r\nthe case/evidence and end express processing. No screening concerns are\r\nautomatically cleared; changed mandate data is revalidated before step 16.","source_rows":[{"id":"AOB-PR-1002-V02-S001","name":"Submit onboarding request - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S002","name":"Triage and classify - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S003","name":"Completeness gateway - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S004","name":"Request clarification (fail path) - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S005","name":"Business approval - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S006","name":"Approval event gateway - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1002-V02-S007","name":"Create onboarding draft - SME Account Opening - Express","disposition":"Retained as source evidence; no one-to-o