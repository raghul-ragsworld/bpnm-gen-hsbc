<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WF-06_definitions" targetNamespace="urn:onboarding:CR-2026-09-17.2:WF-06">
  <bpmn:process id="WF-06_process" name="Corporate KYC Remediation - Event Driven" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Scope remediation to a material event instead of redoing the full KYC\r\npopulation review. Duplicate events at step 4 link to the existing case and\r\nclose; non-material events at step 7 close with rationale. Bad evidence at\r\nstep 12 returns to step 11. New material facts return to step 7 and recompute\r\nscope; reviewer corrections return to step 8 and repeat step 20 and step 21.\r\nDownstream retries resume step 24 only for affected failed destinations.","source_rows":[{"id":"AOB-PR-1003-V02-S001","name":"Submit onboarding request - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S002","name":"Triage and classify - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S003","name":"Completeness gateway - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S004","name":"Request clarification (fail path) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S005","name":"Business approval - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S006","name":"Approval event gateway - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S007","name":"Create onboarding draft - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S008","name":"Package for ingestion - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S009","name":"Ingest to landing - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S010","name":"Technical error handling - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S011","name":"Parallel validations start - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S012","name":"Execute DQ ruleset - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S013","name":"Reference enrichment - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S014","name":"Duplicate detect &amp; merge decision - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S015","name":"Validation join - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S016","name":"Conditional SPECIALIST checks - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S017","name":"Process SPECIALIST review (conditional) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S018","name":"DQ pass gateway - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S019","name":"Remediation loop - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S020","name":"Maker-checker (4-eye) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S021","name":"Publish to onboarding master - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S022","name":"Write controls &amp; DQ metrics - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S023","name":"Distribute to Downstream Systems (transaction) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S024","name":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S025","name":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S026","name":"Publish to Client Reporting Hub topic - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S027","name":"Record publication events - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S028","name":"Update DQ dashboard - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1003-V02-S029","name":"Notify completion - Corporate KYC Remediation - Event Driven","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"}],"source_evidence":{"process":{"Process ID":"AOB-PR-1003-V02","L4 Process Name":"Corporate KYC Remediation - Event Driven","Process Description":"Trigger-based remediation on adverse media events","Process Repository Reference ID":"BUSINESS-RC-CMP-1003","Value Stream":"Risk &amp; Compliance","L2 Business Function":"Regulatory Compliance","Capability":"Master Data Utility","Data Sub-domain":"Compliance Ops","Data Domain":"Risk &amp; Compliance - Regulatory Compliance","Business Data Domain Owner":"Rahul","Business Data Domain Owner Delegate":"Dilip"},"steps":[{"Process Step ID":"AOB-PR-1003-V02-S001","Process ID":"AOB-PR-1003-V02","Reorder":10,"Process Step":"Submit onboarding request - Corporate KYC Remediation - Event Driven","Process Step Description":"Requestor submits onboarding requests with mandatory attributes and evidence references; Tracking ID created.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Request Payload","Target BDEs":"Ticket Record","Data Transformed":"Minimal (format validation)","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S002","Process ID":"AOB-PR-1003-V02","Reorder":20,"Process Step":"Triage and classify - Corporate KYC Remediation - Event Driven","Process Step Description":"Ops reviews request, classifies route (FD/SA), urgency, sets SLA and assigns maker.","Data Involved":"Ticket metadata","Source BDEs":"Ticket Record","Target BDEs":"Routed Ticket","Data Transformed":"Routing tags applied","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S003","Process ID":"AOB-PR-1003-V02","Reorder":30,"Process Step":"Completeness gateway - Corporate KYC Remediation - Event Driven","Process Step Description":"Mandatory fields/evidence check; fail → AOB-PR-1003-V02-S004, pass → AOB-PR-1003-V02-S005.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Routed Ticket","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S004","Process ID":"AOB-PR-1003-V02","Reorder":40,"Process Step":"Request clarification (fail path) - Corporate KYC Remediation - Event Driven","Process Step Description":"Return to requestor with reason codes; loop to AOB-PR-1003-V02-S003.","Data Involved":"Missing field list","Source BDEs":"Routed Ticket","Target BDEs":"Updated Ticket","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S005","Process ID":"AOB-PR-1003-V02","Reorder":50,"Process Step":"Business approval - Corporate KYC Remediation - Event Driven","Process Step Description":"Business approver confirms request is valid and authorised.","Data Involved":"Key Process attributes","Source BDEs":"Routed Ticket","Target BDEs":"Approved/Rejected","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S006","Process ID":"AOB-PR-1003-V02","Reorder":60,"Process Step":"Approval event gateway - Corporate KYC Remediation - Event Driven","Process Step Description":"Wait for approve/reject/withdraw/timeout; timeout → escalation.","Data Involved":"Approval status","Source BDEs":"Approval Task","Target BDEs":"Outcome event","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S007","Process ID":"AOB-PR-1003-V02","Reorder":70,"Process Step":"Create onboarding draft - Corporate KYC Remediation - Event Driven","Process Step Description":"Maker maps request to draft, creates v1 + change log.","Data Involved":"Process attributes","Source BDEs":"Approved Ticket","Target BDEs":"Draft Record v1","Data Transformed":"Standardisation + typing","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S008","Process ID":"AOB-PR-1003-V02","Reorder":80,"Process Step":"Package for ingestion - Corporate KYC Remediation - Event Driven","Process Step Description":"Create ingestion package, apply naming/checksum/encryption.","Data Involved":"Draft Record","Source BDEs":"Draft Record v1","Target BDEs":"Ingestion Package","Data Transformed":"Canonical field mapping","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S009","Process ID":"AOB-PR-1003-V02","Reorder":90,"Process Step":"Ingest to landing - Corporate KYC Remediation - Event Driven","Process Step Description":"Platform ingests package; schema validation.","Data Involved":"Draft + metadata","Source BDEs":"Ingestion Package","Target BDEs":"Landing Record","Data Transformed":"Schema/format coercion","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S010","Process ID":"AOB-PR-1003-V02","Reorder":100,"Process Step":"Technical error handling - Corporate KYC Remediation - Event Driven","Process Step Description":"Incident created; retry/park decision (max 2 retries).","Data Involved":"Error details","Source BDEs":"Ingest logs","Target BDEs":"Incident/Retry/Parked","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S011","Process ID":"AOB-PR-1003-V02","Reorder":110,"Process Step":"Parallel validations start - Corporate KYC Remediation - Event Driven","Process Step Description":"Run DQ, enrichment, duplicate detection in parallel; join at AOB-PR-1003-V02-S015.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Validation outputs","Data Transformed":"Varies","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S012","Process ID":"AOB-PR-1003-V02","Reorder":120,"Process Step":"Execute DQ ruleset - Corporate KYC Remediation - Event Driven","Process Step Description":"Automated DQ checks: completeness, code sets, date logic, uniqueness.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"DQ Results","Data Transformed":"Flags/scores calculated","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S013","Process ID":"AOB-PR-1003-V02","Reorder":130,"Process Step":"Reference enrichment - Corporate KYC Remediation - Event Driven","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S014","Process ID":"AOB-PR-1003-V02","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Corporate KYC Remediation - Event Driven","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S015","Process ID":"AOB-PR-1003-V02","Reorder":150,"Process Step":"Validation join - Corporate KYC Remediation - Event Driven","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S016","Process ID":"AOB-PR-1003-V02","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Corporate KYC Remediation - Event Driven","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S017","Process ID":"AOB-PR-1003-V02","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Corporate KYC Remediation - Event Driven","Process Step Description":"SPECIALIST reviews tax-triggered cases.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Tax Approved / Correction Required","Data Transformed":"Possible corrections","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S018","Process ID":"AOB-PR-1003-V02","Reorder":180,"Process Step":"DQ pass gateway - Corporate KYC Remediation - Event Driven","Process Step Description":"Evaluate DQ + Merge + Specialist outcomes; fail → AOB-PR-1003-V02-S019, pass → AOB-PR-1003-V02-S020.","Data Involved":"DQ + merge + specialist outcomes","Source BDEs":"Validated Draft","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S019","Process ID":"AOB-PR-1003-V02","Reorder":190,"Process Step":"Remediation loop - Corporate KYC Remediation - Event Driven","Process Step Description":"Maker corrects and resubmits; max 3 attempts; loop to AOB-PR-1003-V02-S011.","Data Involved":"Failed fields","Source BDEs":"Fail reasons + draft","Target BDEs":"Corrected Draft / Parked","Data Transformed":"Data corrections","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S020","Process ID":"AOB-PR-1003-V02","Reorder":200,"Process Step":"Maker-checker (4-eye) - Corporate KYC Remediation - Event Driven","Process Step Description":"Checker reviews, approves/rejects with reasons; logged for audit.","Data Involved":"Approved candidate","Source BDEs":"Validated/Corrected Draft","Target BDEs":"Checker Outcome","Data Transformed":"Controlled edits + audit","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S021","Process ID":"AOB-PR-1003-V02","Reorder":210,"Process Step":"Publish to onboarding master - Corporate KYC Remediation - Event Driven","Process Step Description":"Publish to Azure Data Lake master; stamp lineage/audit.","Data Involved":"Approved record","Source BDEs":"Checker Approved Draft","Target BDEs":"Onboarding Master Record","Data Transformed":"Audit stamping","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S022","Process ID":"AOB-PR-1003-V02","Reorder":220,"Process Step":"Write controls &amp; DQ metrics - Corporate KYC Remediation - Event Driven","Process Step Description":"Persist DQ results, approvals, remediation history to controls dataset.","Data Involved":"Control metrics","Source BDEs":"DQ/Workflow outputs","Target BDEs":"Controls &amp; DQ Record","Data Transformed":"Aggregation","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S023","Process ID":"AOB-PR-1003-V02","Reorder":230,"Process Step":"Distribute to Downstream Systems (transaction) - Corporate KYC Remediation - Event Driven","Process Step Description":"Parallel fan-out; record per-consumer status; allow replay.","Data Involved":"Published record","Source BDEs":"Onboarding Master Record","Target BDEs":"Consumer payloads + statuses","Data Transformed":"Consumer mapping","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S024","Process ID":"AOB-PR-1003-V02","Reorder":240,"Process Step":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Corporate KYC Remediation - Event Driven","Process Step Description":"Produce DDT-specific extract and deliver.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"DDT delivery","Data Transformed":"Schema mapping","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S025","Process ID":"AOB-PR-1003-V02","Reorder":250,"Process Step":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Corporate KYC Remediation - Event Driven","Process Step Description":"Deliver via API MANAGEMENT + AZURE FUNCTIONS (OR API INTEGRATION LAYER (AZURE API MANAGEMENT)) to Analytics Consumer B with retries and idempotency using Tracking ID.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"Analytics delivery","Data Transformed":"Schema mapping","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S026","Process ID":"AOB-PR-1003-V02","Reorder":260,"Process Step":"Publish to Client Reporting Hub topic - Corporate KYC Remediation - Event Driven","Process Step Description":"Publish event/message to Reporting Consumer C (Hackathon) or Downstream Reporting Hub (Consumer C) via Azure Service Bus Topic.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"CRH message","Data Transformed":"Event translation","L4 Process Name":"Corporate KYC Remediation - Event Driven"},{"Process Step ID":"AOB-PR-1003-V02-S027","Process ID":"AOB-PR-1003-V02","Reorder":270,"Process Step":"Record publication events - Corporate KYC Remediation - Event Driven","Process Step Des