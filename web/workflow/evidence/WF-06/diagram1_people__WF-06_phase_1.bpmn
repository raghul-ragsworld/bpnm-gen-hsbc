 Owner":"Service Management Team","RACI":"R=Service Management Team, A=Platform Lead, C=Integration Team, I=Ops Lead"},{"PSD ID":"PSD-AOB-PR-1003-V02-S011-01","Process Step ID":"AOB-PR-1003-V02-S011","Process Step":"Parallel validations start - Corporate KYC Remediation - Event Driven","Detail Type":"Gateway (AND)","Detail Value":"Spawn AOB-PR-1003-V02-S012, AOB-PR-1003-V02-S013, AOB-PR-1003-V02-S014 in parallel; join at AOB-PR-1003-V02-S015","Process Step Owner":"Data Platform Team","RACI":"R=Data Platform Team, A=Platform Lead, C=Process Ops, I=Steward"},{"PSD ID":"PSD-AOB-PR-1003-V02-S012-01","Process Step ID":"AOB-PR-1003-V02-S012","Process Step":"Execute DQ ruleset - Corporate KYC Remediation - Event Driven","Detail Type":"Application","Detail Value":"DQ Engine","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=DQ Lead, C=Onboarding Ops, I=Steward"},{"PSD ID":"PSD-AOB-PR-1003-V02-S012-02","Process Step ID":"AOB-PR-1003-V02-S012","Process Step":"Execute DQ ruleset - Corporate KYC Remediation - Event Driven","Detail Type":"Rule Set","Detail Value":"Completeness; ISO codes; date logic; uniqueness; format constraints","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=DQ Lead, C=Onboarding Ops, I=Steward"},{"PSD ID":"PSD-AOB-PR-1003-V02-S012-03","Process Step ID":"AOB-PR-1003-V02-S012","Process Step":"Execute DQ ruleset - Corporate KYC Remediation - Event Driven","Detail Type":"Output","Detail Value":"Produce DQ Rule Failures and interim DQ Score inputs (rule severities)","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=DQ Lead, C=Onboarding Ops, I=Steward"},{"PSD ID":"PSD-AOB-PR-1003-V02-S013-01","Process Step ID":"AOB-PR-1003-V02-S013","Process Step":"Reference enrichment - Corporate KYC Remediation - Event Driven","Detail Type":"Application","Detail Value":"Azure Data LakeLanding / reference lookup services","Process Step Owner":"Steward","RACI":"R=Steward, A=Data Owner, C=Process Ops, I=Onboarding Ops"},{"PSD ID":"PSD-AOB-PR-1003-V