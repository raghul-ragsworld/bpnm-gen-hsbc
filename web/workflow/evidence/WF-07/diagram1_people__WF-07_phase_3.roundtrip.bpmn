ocess Step ID":"AOB-PR-1004-V01-S013","Process ID":"AOB-PR-1004-V01","Reorder":130,"Process Step":"Reference enrichment - Trade Finance Client Setup","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Trade Finance Client Setup"},{"Process Step ID":"AOB-PR-1004-V01-S014","Process ID":"AOB-PR-1004-V01","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Trade Finance Client Setup","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Trade Finance Client Setup"},{"Process Step ID":"AOB-PR-1004-V01-S015","Process ID":"AOB-PR-1004-V01","Reorder":150,"Process Step":"Validation join - Trade Finance Client Setup","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Trade Finance Client Setup"},{"Process Step ID":"AOB-PR-1004-V01-S016","Process ID":"AOB-PR-1004-V01","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Trade Finance Client Setup","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Trade Finance Client Setup"},{"Process Step ID":"AOB-PR-1004-V01-S017","Process ID":"AOB-PR-1004-V01","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Trade Finance Client Setup","Process Step Description":"S