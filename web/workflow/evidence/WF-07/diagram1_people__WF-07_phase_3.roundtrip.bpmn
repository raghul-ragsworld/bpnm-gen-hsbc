  <bpmn:process id="WF-07_process" name="Trade Finance Client Setup" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Expand trade risk, credit, legal execution, and entitlement testing.\r\nScreening concerns stop at step 13 pending clearance/decline. Credit changes\r\nreturn to step 17 and repeat step 18 through step 21. Legal defects return to\r\nstep 22; material term changes require credit reapproval at step 21. Missing\r\nprerequisites hold step 25. Entitlement failures return to step 30 or step 31,\r\nthen repeat step 33 and step 34 before activation.","source_rows":[{"id":"AOB-PR-1004-V01-S001","name":"Submit onboarding request - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S002","name":"Triage and classify - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S003","name":"Completeness gateway - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S004","name":"Request clarification (fail path) - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S005","name":"Business approval - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S006","name":"Approval event gateway - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1004-V01-S007","name":"Create onboarding draft - Trade Finance Client Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id"