  <bpmn:process id="WF-09_process" name="Treasury Counterparty Onboarding" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Separate credit, legal execution, independent instruction validation,\r\nand operational readiness. Agreement corrections return to step 16 and repeat\r\nstep 17 and step 18; changed credit terms also repeat step 13 and step 14.\r\nInstruction failures return to step 20 and repeat step 21 and step 22. Failed\r\nrouting tests return to step 26; permission failures return to step 27. Both\r\napproved limits and verified instructions are required before step 29.","source_rows":[{"id":"AOB-PR-1005-V01-S001","name":"Submit onboarding request - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S002","name":"Triage and classify - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S003","name":"Completeness gateway - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S004","name":"Request clarification (fail path) - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S005","name":"Business approval - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S006","name":"Approval event gateway - Treasury Counterparty Onboarding","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V01-S007","name":"Create onboarding draft - Treasury Counterparty Onboarding","disposition":"Retained as source