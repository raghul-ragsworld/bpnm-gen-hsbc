  <bpmn:process id="WF-10_process" name="Treasury Counterparty Onboarding - NBFI" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Add status, funding, liquidity, governance, and collateral controls.\r\nUnresolved status at step 5 enters hold/decline; evidence remediation repeats\r\nstep 5 and step 6 before progression. Funding gaps return to step 9, and\r\nenhanced-diligence gaps return to step 16. Collateral changes return to step 22\r\nand repeat approval at step 24 plus affected agreements. Settlement failures\r\nreturn to step 29. Readiness test failures return only to the affected step 34,\r\nstep 35, or step 36 and repeat step 37; no unrestricted activation is allowed.","source_rows":[{"id":"AOB-PR-1005-V02-S001","name":"Submit onboarding request - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V02-S002","name":"Triage and classify - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V02-S003","name":"Completeness gateway - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V02-S004","name":"Request clarification (fail path) - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V02-S005","name":"Business approval - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1005-V02-S006","name":"Approval event gateway - Treasury Counterparty Onboarding - NBFI","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"