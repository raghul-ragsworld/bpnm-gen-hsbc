  <bpmn:process id="WF-11_process" name="Wealth Client Profiling" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Decompose suitability into capacity, knowledge, experience, tolerance,\r\nand acknowledgement, without unnecessary account provisioning. Incomplete\r\nresponses return from step 13 to the affected capture task. Contradictions\r\nenter step 15 then repeat step 14; consistent responses bypass step 15.\r\nDeclined acknowledgement at step 19 returns to step 18 for discussion, then\r\nto affected assessment tasks if facts change, or closes as withdrawn. A profile\r\nis not approval of a particular trade.","source_rows":[{"id":"AOB-PR-1006-V01-S001","name":"Submit onboarding request - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S002","name":"Triage and classify - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S003","name":"Completeness gateway - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S004","name":"Request clarification (fail path) - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S005","name":"Business approval - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S006","name":"Approval event gateway - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1006-V01-S007","name":"Create onboarding draft - Wealth Client Profiling","disposition":"Retained as source evidence; no one-to-o