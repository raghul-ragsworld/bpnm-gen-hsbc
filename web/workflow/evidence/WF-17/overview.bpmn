<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WF-17_definitions" targetNamespace="urn:onboarding:CR-2026-09-17.2:WF-17">
  <bpmn:process id="WF-17_process" name="Loan Origination Party Setup" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Expand party identity, authority, relationships, and origination handoff\r\nwithout adding lending decisions to setup. Evidence gaps return to step 6.\r\nAmbiguous matches enter step 9 then repeat step 8; clear matches bypass it.\r\nAuthority failures return to step 16. Relationship corrections return to\r\nstep 14 or step 15, repeat step 18, then step 19 and step 20. Handoff failures\r\nretry step 22 without duplicating master records. This does not approve or\r\ndisburse a loan.","source_rows":[{"id":"AOB-PR-1009-V01-S001","name":"Submit onboarding request - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S002","name":"Triage and classify - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S003","name":"Completeness gateway - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S004","name":"Request clarification (fail path) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S005","name":"Business approval - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S006","name":"Approval event gateway - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S007","name":"Create onboarding draft - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S008","name":"Package for ingestion - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S009","name":"Ingest to landing - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S010","name":"Technical error handling - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S011","name":"Parallel validations start - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S012","name":"Execute DQ ruleset - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S013","name":"Reference enrichment - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S014","name":"Duplicate detect &amp; merge decision - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S015","name":"Validation join - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S016","name":"Conditional SPECIALIST checks - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S017","name":"Process SPECIALIST review (conditional) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S018","name":"DQ pass gateway - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S019","name":"Remediation loop - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S020","name":"Maker-checker (4-eye) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S021","name":"Publish to onboarding master - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S022","name":"Write controls &amp; DQ metrics - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S023","name":"Distribute to Downstream Systems (transaction) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S024","name":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S025","name":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S026","name":"Publish to Client Reporting Hub topic - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S027","name":"Record publication events - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S028","name":"Update DQ dashboard - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V01-S029","name":"Notify completion - Loan Origination Party Setup","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"}],"source_evidence":{"process":{"Process ID":"AOB-PR-1009-V01","L4 Process Name":"Loan Origination Party Setup","Process Description":"Borrower/co-borrower setup and underwriting data capture","Process Repository Reference ID":"BUSINESS-LL-COR-1009","Value Stream":"Lending Lifecycle","L2 Business Function":"Credit Origination","Capability":"Master Data Utility","Data Sub-domain":"Lending Operations","Data Domain":"Lending Lifecycle - Credit Origination","Business Data Domain Owner":"ilyas","Business Data Domain Owner Delegate":"lindas"},"steps":[{"Process Step ID":"AOB-PR-1009-V01-S001","Process ID":"AOB-PR-1009-V01","Reorder":10,"Process Step":"Submit onboarding request - Loan Origination Party Setup","Process Step Description":"Requestor submits onboarding requests with mandatory attributes and evidence references; Tracking ID created.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Request Payload","Target BDEs":"Ticket Record","Data Transformed":"Minimal (format validation)","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S002","Process ID":"AOB-PR-1009-V01","Reorder":20,"Process Step":"Triage and classify - Loan Origination Party Setup","Process Step Description":"Ops reviews request, classifies route (FD/SA), urgency, sets SLA and assigns maker.","Data Involved":"Ticket metadata","Source BDEs":"Ticket Record","Target BDEs":"Routed Ticket","Data Transformed":"Routing tags applied","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S003","Process ID":"AOB-PR-1009-V01","Reorder":30,"Process Step":"Completeness gateway - Loan Origination Party Setup","Process Step Description":"Mandatory fields/evidence check; fail → AOB-PR-1009-V01-S004, pass → AOB-PR-1009-V01-S005.","Data Involved":"Process attributes + evidence refs","Source BDEs":"Routed Ticket","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S004","Process ID":"AOB-PR-1009-V01","Reorder":40,"Process Step":"Request clarification (fail path) - Loan Origination Party Setup","Process Step Description":"Return to requestor with reason codes; loop to AOB-PR-1009-V01-S003.","Data Involved":"Missing field list","Source BDEs":"Routed Ticket","Target BDEs":"Updated Ticket","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S005","Process ID":"AOB-PR-1009-V01","Reorder":50,"Process Step":"Business approval - Loan Origination Party Setup","Process Step Description":"Business approver confirms request is valid and authorised.","Data Involved":"Key Process attributes","Source BDEs":"Routed Ticket","Target BDEs":"Approved/Rejected","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S006","Process ID":"AOB-PR-1009-V01","Reorder":60,"Process Step":"Approval event gateway - Loan Origination Party Setup","Process Step Description":"Wait for approve/reject/withdraw/timeout; timeout → escalation.","Data Involved":"Approval status","Source BDEs":"Approval Task","Target BDEs":"Outcome event","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S007","Process ID":"AOB-PR-1009-V01","Reorder":70,"Process Step":"Create onboarding draft - Loan Origination Party Setup","Process Step Description":"Maker maps request to draft, creates v1 + change log.","Data Involved":"Process attributes","Source BDEs":"Approved Ticket","Target BDEs":"Draft Record v1","Data Transformed":"Standardisation + typing","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S008","Process ID":"AOB-PR-1009-V01","Reorder":80,"Process Step":"Package for ingestion - Loan Origination Party Setup","Process Step Description":"Create ingestion package, apply naming/checksum/encryption.","Data Involved":"Draft Record","Source BDEs":"Draft Record v1","Target BDEs":"Ingestion Package","Data Transformed":"Canonical field mapping","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S009","Process ID":"AOB-PR-1009-V01","Reorder":90,"Process Step":"Ingest to landing - Loan Origination Party Setup","Process Step Description":"Platform ingests package; schema validation.","Data Involved":"Draft + metadata","Source BDEs":"Ingestion Package","Target BDEs":"Landing Record","Data Transformed":"Schema/format coercion","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S010","Process ID":"AOB-PR-1009-V01","Reorder":100,"Process Step":"Technical error handling - Loan Origination Party Setup","Process Step Description":"Incident created; retry/park decision (max 2 retries).","Data Involved":"Error details","Source BDEs":"Ingest logs","Target BDEs":"Incident/Retry/Parked","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S011","Process ID":"AOB-PR-1009-V01","Reorder":110,"Process Step":"Parallel validations start - Loan Origination Party Setup","Process Step Description":"Run DQ, enrichment, duplicate detection in parallel; join at AOB-PR-1009-V01-S015.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Validation outputs","Data Transformed":"Varies","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S012","Process ID":"AOB-PR-1009-V01","Reorder":120,"Process Step":"Execute DQ ruleset - Loan Origination Party Setup","Process Step Description":"Automated DQ checks: completeness, code sets, date logic, uniqueness.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"DQ Results","Data Transformed":"Flags/scores calculated","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S013","Process ID":"AOB-PR-1009-V01","Reorder":130,"Process Step":"Reference enrichment - Loan Origination Party Setup","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S014","Process ID":"AOB-PR-1009-V01","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Loan Origination Party Setup","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S015","Process ID":"AOB-PR-1009-V01","Reorder":150,"Process Step":"Validation join - Loan Origination Party Setup","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S016","Process ID":"AOB-PR-1009-V01","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Loan Origination Party Setup","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S017","Process ID":"AOB-PR-1009-V01","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Loan Origination Party Setup","Process Step Description":"SPECIALIST reviews tax-triggered cases.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Tax Approved / Correction Required","Data Transformed":"Possible corrections","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S018","Process ID":"AOB-PR-1009-V01","Reorder":180,"Process Step":"DQ pass gateway - Loan Origination Party Setup","Process Step Description":"Evaluate DQ + Merge + Specialist outcomes; fail → AOB-PR-1009-V01-S019, pass → AOB-PR-1009-V01-S020.","Data Involved":"DQ + merge + specialist outcomes","Source BDEs":"Validated Draft","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S019","Process ID":"AOB-PR-1009-V01","Reorder":190,"Process Step":"Remediation loop - Loan Origination Party Setup","Process Step Description":"Maker corrects and resubmits; max 3 attempts; loop to AOB-PR-1009-V01-S011.","Data Involved":"Failed fields","Source BDEs":"Fail reasons + draft","Target BDEs":"Corrected Draft / Parked","Data Transformed":"Data corrections","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S020","Process ID":"AOB-PR-1009-V01","Reorder":200,"Process Step":"Maker-checker (4-eye) - Loan Origination Party Setup","Process Step Description":"Checker reviews, approves/rejects with reasons; logged for audit.","Data Involved":"Approved candidate","Source BDEs":"Validated/Corrected Draft","Target BDEs":"Checker Outcome","Data Transformed":"Controlled edits + audit","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S021","Process ID":"AOB-PR-1009-V01","Reorder":210,"Process Step":"Publish to onboarding master - Loan Origination Party Setup","Process Step Description":"Publish to Azure Data Lake master; stamp lineage/audit.","Data Involved":"Approved record","Source BDEs":"Checker Approved Draft","Target BDEs":"Onboarding Master Record","Data Transformed":"Audit stamping","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S022","Process ID":"AOB-PR-1009-V01","Reorder":220,"Process Step":"Write controls &amp; DQ metrics - Loan Origination Party Setup","Process Step Description":"Persist DQ results, approvals, remediation history to controls dataset.","Data Involved":"Control metrics","Source BDEs":"DQ/Workflow outputs","Target BDEs":"Controls &amp; DQ Record","Data Transformed":"Aggregation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S023","Process ID":"AOB-PR-1009-V01","Reorder":230,"Process Step":"Distribute to Downstream Systems (transaction) - Loan Origination Party Setup","Process Step Description":"Parallel fan-out; record per-consumer status; allow replay.","Data Involved":"Published record","Source BDEs":"Onboarding Master Record","Target BDEs":"Consumer payloads + statuses","Data Transformed":"Consumer mapping","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S024","Process ID":"AOB-PR-1009-V01","Reorder":240,"Process Step":"Publish to DDT (alias: External Consumer A (Market Data) or Downstream Consumer A) - Loan Origination Party Setup","Process Step Description":"Produce DDT-specific extract and deliver.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"DDT delivery","Data Transformed":"Schema mapping","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S025","Process ID":"AOB-PR-1009-V01","Reorder":250,"Process Step":"Publish to Portfolio Analytics Platform (ANALYTICS CONSUMER B (HACKATHON) OR AZURE SYNAPSE/DATABRICKS ANALYTICS WORKSPACE) (alias: Analytics Platform) - Loan Origination Party Setup","Process Step Description":"Deliver via API MANAGEMENT + AZURE FUNCTIONS (OR API INTEGRATION LAYER (AZURE API MANAGEMENT)) to Analytics Consumer B with retries and idempotency using Tracking ID.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"Analytics delivery","Data Transformed":"Schema mapping","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S026","Process ID":"AOB-PR-1009-V01","Reorder":260,"Process Step":"Publish to Client Reporting Hub topic - Loan Origination Party Setup","Process Step Description":"Publish event/message to Reporting Consumer C (Hackathon) or Downstream Reporting Hub (Consumer C) via Azure Service Bus Topic.","Data Involved":"Consumer payload","Source BDEs":"Consumer payload","Target BDEs":"CRH message","Data Transformed":"Event translation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S027","Process ID":"AOB-PR-1009-V01","Reorder":270,"Process Step":"Record publication events - Loan Origination Party Setup","Process Step Description":"Append delivery events for audit/replay/monitoring.","Data Involved":"Event data","Source BDEs":"Delivery outcomes","Target BDEs":"Publication Events","Data Transformed":"Event normalisation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S028","Process ID":"AOB-PR-1009-V01","Reorder":280,"Process Step":"Update DQ dashboard - Loan Origination Party Setup","Process Step Description":"Refresh dashboard with status + DQ metrics.","Data Involved":"Metrics","Source BDEs":"Controls &amp; DQ Record","Target BDEs":"Dashboard view","Data Transformed":"Aggregation","L4 Process Name":"Loan Origination Party Setup"},{"Process Step ID":"AOB-PR-1009-V01-S029","Process ID":"AOB-PR-1009-V01","Reorder":290,"Process Step":"Notify completion - Loan Origination Party Setup","Process Step Description":"Notify requestor/stakeholders with outcome + Tracking ID.","Data Involved":"Status","Source BDEs":"Publication Events","Target BDEs":"Notifications","Data Transformed":"None","L4 Process Name":"Loan Origination Party Setup"}],"details":[{"PSD ID":"PSD-AOB-PR-1009-V01-S001-01","Process Step ID":"AOB-PR-1009-V01-S001","Process Step":"Submit onboarding request - Loan Origination Party Setup","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1009-V01-S001-02","Process Step ID":"AOB-PR-1009-V01-S001","Process Step":"Submit onboarding request - Loan Origination Party Setup","Detail Type":"Input","Detail Value":"Process attributes + Supporting Evidence References","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1009-V01-S001-03","Process Step ID":"AOB-PR-1009-V01-S001","Process Step":"Submit onboarding request - Loan Origination Party Setup","Detail Type":"Tracking","Detail Value":"Create Tracking ID (Correlation ID) at intake; persist end-to-end","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1009-V01-S001-04","Process Step ID":"AOB-PR-1009-V01-S001","Process Step":"Submit onboarding request - Loan Origination Party Setup","Detail Type":"Output","Detail Value":"Ticket contains submitted Process attributes, Supporting Evidence References, and Tracking ID","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1009-V01-S002-01","Process Step ID":"AOB-PR-1009-V01-S002","Process Step":"Triage and classify - Loan Origination Party Setup","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1009-V01-S002-02","Process Step ID":"AOB-PR-1009-V01-S002","Process Step":"Triage and classify 