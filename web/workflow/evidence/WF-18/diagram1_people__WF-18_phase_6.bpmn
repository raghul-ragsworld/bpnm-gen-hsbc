  <bpmn:process id="WF-18_process" name="Loan Origination Party Setup - Secured" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Add security-provider identification, ownership comparison, joint-party\r\nconsent, and explicit downstream legal/valuation handoff. Ownership mismatch\r\nat step 22 returns to step 21; newly identified providers at step 23 repeat\r\nstep 4 through step 19 for those parties only. Missing authority returns to\r\nstep 18. Linkage issues at step 26 or step 30 return to step 25 and repeat\r\nstep 29 through step 32. Failed handoff retries step 35 only. Step 28 and\r\nstep 35 must preserve unresolved valuation, perfection, and lending gates;\r\nsetup completion cannot imply those downstream decisions are approved.","source_rows":[{"id":"AOB-PR-1009-V02-S001","name":"Submit onboarding request - Loan Origination Party Setup - Secured","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V02-S002","name":"Triage and classify - Loan Origination Party Setup - Secured","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V02-S003","name":"Completeness gateway - Loan Origination Party Setup - Secured","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V02-S004","name":"Request clarification (fail path) - Loan Origination Party Setup - Secured","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V02-S005","name":"Business approval - Loan Origination Party Setup - Secured","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1009-V02-S006","name":"Approval event gateway - Loan Origination Party Setup - Secured","disposition":"Retained as so