<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="WF-20_definitions" targetNamespace="urn:onboarding:CR-2026-09-17.2:WF-20">
  <bpmn:process id="WF-20_process" name="Custody Account Setup - Global Markets" isExecutable="false">
    <bpmn:documentation>{"version":"CR-2026-09-17.2","basis":"Proposed synthetic requirements, implemented as descriptive BPMN. Not independently business-validated; not executable bank policy.","status":"Proposed","requirement":"docs/Process_Specific_Steps_Proposed.md","routing":"Add local registration, tax, sub-custody, currency, and servicing\r\ncontrols. Step 9 through step 26 runs independently per market; unresolved\r\neligibility at step 9 holds that market rather than proceeding. Documentary\r\nfailures return to the affected step 13, step 15, or step 18 and revalidate.\r\nAfter scope approval, step 28 through step 36 runs per market; failed tests\r\nenter step 36 then return to affected configuration at step 29 through step 33\r\nand retest. Readiness joins at step 37 cover the approved scope only. Changing\r\nscope at step 38 requires step 27 approval again; exclusions remain recorded\r\nas deferred/declined, never complete. Already active markets are not replayed.","source_rows":[{"id":"AOB-PR-1010-V02-S001","name":"Submit onboarding request - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S002","name":"Triage and classify - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S003","name":"Completeness gateway - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S004","name":"Request clarification (fail path) - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S005","name":"Business approval - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S006","name":"Approval event gateway - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S007","name":"Create onboarding draft - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S008","name":"Package for ingestion - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S009","name":"Ingest to landing - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S010","name":"Technical error handling - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S011","name":"Parallel validations start - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S012","name":"Execute DQ ruleset - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S013","name":"Reference enrichment - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S014","name":"Duplicate detect &amp; merge decision - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S015","name":"Validation join - Custody Account Setup - Global Markets","disposition":"Retained as source evidence; no one-to-one executable mapping asserted"},{"id":"AOB-PR-1010-V02-S016","name":"Conditional SPECIALIST checks - Custody Account Setup - Global Markets","disposition":"Retained as s