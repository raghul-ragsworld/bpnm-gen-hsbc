ss Step":"Submit onboarding request - Custody Account Setup - Global Markets","Detail Type":"Tracking","Detail Value":"Create Tracking ID (Correlation ID) at intake; persist end-to-end","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1010-V02-S001-04","Process Step ID":"AOB-PR-1010-V02-S001","Process Step":"Submit onboarding request - Custody Account Setup - Global Markets","Detail Type":"Output","Detail Value":"Ticket contains submitted Process attributes, Supporting Evidence References, and Tracking ID","Process Step Owner":"Requestor","RACI":"R=Requestor, A=Approver, C=Onboarding Ops, I=Process Ops"},{"PSD ID":"PSD-AOB-PR-1010-V02-S002-01","Process Step ID":"AOB-PR-1010-V02-S002","Process Step":"Triage and classify - Custody Account Setup - Global Markets","Detail Type":"Application","Detail Value":"Work Tracking Tool (Azure DevOps Boards)","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1010-V02-S002-02","Process Step ID":"AOB-PR-1010-V02-S002","Process Step":"Triage and classify - Custody Account Setup - Global Markets","Detail Type":"Output","Detail Value":"Set Routing Category, Urgency, SLA Target; assign maker","Process Step Owner":"Onboarding Ops","RACI":"R=Onboarding Ops, A=Ops Lead, C=Process Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1010-V02-S003-01","Process Step ID":"AOB-PR-1010-V02-S003","Process Step":"Completeness gateway - Custody Account Setup - Global Markets","Detail Type":"Gateway Rule (XOR)","Detail Value":"If any mandatory attribute missing OR evidence missing -&gt; AOB-PR-1010-V02-S004; else -&gt; AOB-PR-1010-V02-S005","Process Step Owner":"Process Ops","RACI":"R=Process Ops, A=Ops Lead, C=Onboarding Ops, I=Requestor"},{"PSD ID":"PSD-AOB-PR-1010-V02-S003-02","Process Step ID":"AOB-PR-1010-V02-S003","Process Step":"Completeness gateway - Custody Account Setup - Global Markets","Detail Type":"M