1","Process ID":"AOB-PR-1010-V02","Reorder":110,"Process Step":"Parallel validations start - Custody Account Setup - Global Markets","Process Step Description":"Run DQ, enrichment, duplicate detection in parallel; join at AOB-PR-1010-V02-S015.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Validation outputs","Data Transformed":"Varies","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S012","Process ID":"AOB-PR-1010-V02","Reorder":120,"Process Step":"Execute DQ ruleset - Custody Account Setup - Global Markets","Process Step Description":"Automated DQ checks: completeness, code sets, date logic, uniqueness.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"DQ Results","Data Transformed":"Flags/scores calculated","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S013","Process ID":"AOB-PR-1010-V02","Reorder":130,"Process Step":"Reference enrichment - Custody Account Setup - Global Markets","Process Step Description":"Standardize country/currency/team codes.","Data Involved":"Landing record","Source BDEs":"Landing Record","Target BDEs":"Enriched Record","Data Transformed":"Lookup + normalisation","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S014","Process ID":"AOB-PR-1010-V02","Reorder":140,"Process Step":"Duplicate detect &amp; merge decision - Custody Account Setup - Global Markets","Process Step Description":"Detect duplicates; merge/reject/proceed decision.","Data Involved":"Identity fields","Source BDEs":"Enriched Record","Target BDEs":"Merge Outcome","Data Transformed":"Fuzzy match + survivorship","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S015","Process ID":"AOB-PR-1010-V02","Reorder":150,"Process Step":"Validation join - Custody Account Setup - Global Markets","Process Step Description":"Consolidate parallel outputs into Validated Draft.","Data Involved":"DQ + enriched + merge","Source BDEs":"DQ/Enriched/Merge Results","Target BDEs":"Validated Draft","Data Transformed":"Consolidation","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S016","Process ID":"AOB-PR-1010-V02","Reorder":160,"Process Step":"Conditional SPECIALIST checks - Custody Account Setup - Global Markets","Process Step Description":"Determine if Process SPECIALIST review is required based on explicit Tax Review Basis derived from Process Status and Process Type.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Specialist Review Flag","Data Transformed":"Rule evaluation","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S017","Process ID":"AOB-PR-1010-V02","Reorder":170,"Process Step":"Process SPECIALIST review (conditional) - Custody Account Setup - Global Markets","Process Step Description":"SPECIALIST reviews tax-triggered cases.","Data Involved":"Tax review routing data","Source BDEs":"Validated Draft","Target BDEs":"Tax Approved / Correction Required","Data Transformed":"Possible corrections","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S018","Process ID":"AOB-PR-1010-V02","Reorder":180,"Process Step":"DQ pass gateway - Custody Account Setup - Global Markets","Process Step Description":"Evaluate DQ + Merge + Specialist outcomes; fail → AOB-PR-1010-V02-S019, pass → AOB-PR-1010-V02-S020.","Data Involved":"DQ + merge + specialist outcomes","Source BDEs":"Validated Draft","Target BDEs":"Pass/Fail decision","Data Transformed":"None","L4 Process Name":"Custody Account Setup - Global Markets"},{"Process Step ID":"AOB-PR-1010-V02-S019","Process ID":"AOB-PR-1010-V02","Reorder":190,"Process Step":"Remediation loop - Custody Account Setup - Global Markets","Process Step Description":"Maker corrects and resubmits; max 3 attempts;